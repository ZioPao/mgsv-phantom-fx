// The add-on's version resource, filled in by CMake. ReShade shows ProductName, CompanyName and the
// file version in its add-on list and log.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bustanity"
            VALUE "FileDescription", "Phantom FX"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "PhantomFX"
            VALUE "LegalCopyright", "Copyright (c) 2026 Bustanity, MIT License"
            VALUE "OriginalFilename", "PhantomFX.addon64"
            VALUE "ProductName", "Phantom FX"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
